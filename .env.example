# Copy to .env and edit. `npm start` loads .env automatically; systemd uses
# EnvironmentFile and Docker uses --env-file. Never commit .env.
# Lines starting with # are defaults/examples and are ignored.

# ---- Server -----------------------------------------------------------------
# PORT=3000
# 127.0.0.1 = only reachable through a reverse proxy on the same machine
# (nginx/Caddy/Cloudflare Tunnel). Leave unset to listen on all interfaces.
# HOST=127.0.0.1

# Which proxy to trust for the real client IP (X-Forwarded-For). Default
# "loopback" fits nginx on the same machine. Docker behind host nginx:
# "uniquelocal". Behind one known hop: "1". Wrong values let users fake IPs
# (bypassing limits) or make all users share one limit.
# TRUST_PROXY=loopback

# Other websites allowed to call the API from a browser (comma-separated).
# Empty = only the bundled UI. "*" = everyone (not recommended).
# CORS_ORIGIN=https://example.com

# Set to 0 to disable the access log.
# LOG_REQUESTS=1

# ---- Admin ------------------------------------------------------------------
# Long random secret. Unlocks detailed /api/health and the update endpoint
# (send "Authorization: Bearer <token>"). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ADMIN_TOKEN=
# Also needed for POST /api/admin/update-ytdlp
# ALLOW_UPDATE=0

# Update yt-dlp automatically every N hours while the server is idle. 0 = off.
# AUTO_UPDATE_HOURS=24

# ---- YouTube access -----------------------------------------------------------
# Netscape-format cookies from a logged-in (spare!) YouTube account. Helps with
# "confirm you're not a bot" and age-restricted videos. The account can get
# banned if the server is abused, so never use your main account.
# COOKIES_FILE=./cookies.txt

# Proxy for all YouTube traffic, e.g. a residential proxy when the server's IP
# is blocked, or a proxy in another country for region-locked videos.
# YTDLP_PROXY=http://user:pass@proxy.example.com:8080
# YTDLP_PROXY=socks5://127.0.0.1:1080
# YTDLP_FORCE_IPV4=0

# Advanced yt-dlp tuning
# YTDLP_PATH=./bin/yt-dlp.exe
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=tv,web_safari
# YTDLP_JS_RUNTIME=auto            # auto | always | off
# YTDLP_JS_RUNTIME_PATH=
# YTDLP_CONCURRENT_FRAGMENTS=8
# YTDLP_TIMEOUT_MS=45000           # one metadata attempt
# YTDLP_INFO_DEADLINE_MS=55000     # all metadata attempts together

# ---- Limits -------------------------------------------------------------------
# MAX_DURATION_SEC=10800           # longest video allowed (3 h)
# MAX_FILE_MB=2048                 # largest single file
# MAX_DISK_MB=5120                 # total temp space for jobs
# MIN_FREE_DISK_MB=1024            # always leave this much disk free
# JOB_CONCURRENCY=2                # downloads running at once
# JOB_MAX_QUEUE=30                 # downloads waiting
# JOBS_PER_IP=3                    # active downloads per user
# JOB_TTL_MS=900000                # keep finished files for 15 min
# JOB_TIMEOUT_MS=1800000           # stop a download after 30 min
# JOBS_DIR=                        # default: <system temp>/ytdl-jobs-<PORT>
# EXTRACT_CONCURRENCY=4            # metadata lookups at once
# EXTRACT_QUEUE=40                 # metadata lookups waiting
# INFO_CACHE_MS=600000             # cache video info for 10 min
# INFO_CACHE_MAX=150

# ---- Install (npm install / npm run setup) -----------------------------------
# YTDLP_VERSION=                   # default: pinned in scripts/ytdlp.lock.json
# SKIP_YTDLP_DOWNLOAD=0
# YTDLP_STRICT=0                   # 1 = fail the install if yt-dlp can't be verified
