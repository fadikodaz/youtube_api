{
  "name": "youtube_panga",
  "version": "2.0.0",
  "description": "Fast YouTube audio downloader (yt-dlp + ffmpeg) with video/audio preview",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "setup": "node scripts/fetch-ytdlp.js",
    "postinstall": "node scripts/fetch-ytdlp.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": ["youtube", "mp3", "yt-dlp", "ffmpeg", "downloader"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
